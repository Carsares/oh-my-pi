{
  "version": "18.0.4",
  "binary": "omp",
  "commands": [
    "abort",
    "branch",
    "compact",
    "get_available_commands",
    "get_available_models",
    "get_messages",
    "get_session_stats",
    "get_state",
    "prompt",
    "set_auto_compaction",
    "set_follow_up_mode",
    "set_model",
    "set_session_name",
    "set_steering_mode",
    "set_thinking_level"
  ],
  "stateFields": [
    "autoCompactionEnabled",
    "followUpMode",
    "isCompacting",
    "isStreaming",
    "messageCount",
    "model",
    "queuedMessageCount",
    "sessionId",
    "steeringMode",
    "thinkingLevel"
  ],
  "desktopMappings": {
    "fork": "branch",
    "get_commands": "get_available_commands",
    "get_available_thinking_levels": "get_available_models.thinking.efforts",
    "pendingMessageCount": "queuedMessageCount"
  },
  "branchResponseFields": ["cancelled", "text"],
  "thinkingLevelsSource": "model.thinking.efforts"
}
